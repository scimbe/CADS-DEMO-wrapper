# Freie Karte 2 P3/P4: zusaetzliche Umgebung fuer den Produktions-Wrapper (demos-wrapper). Der Integrator uebernimmt sie in
# sein Deploy-Muster (neues Image, gleiche Env plus diese Zeilen, deploy-check, automatischer Rollback); release.sh ersetzt
# den Wrapper nicht. Keine Geheimnisse hier: nur Pfade. Dazu --env-file ~/demos-wrapper-secrets/smtp.env (wrapper-mounts.txt).
DUELL_BAU=on
DUELL_BAU_TOKEN_FILE=/run/secrets/fk2-bau.token
# eigener Listener nur fuer /api/intern/fk2/* (nie veroeffentlicht; nur das Netz mdi-bau-net erreicht ihn)
DUELL_BAU_PORT=8791
# Netz des Bau-Workers (release.sh legt mdi-bau-net genau so an): von dort beantwortet der oeffentliche Port nichts
DUELL_BAU_NETZ=172.31.250.0/28
DUELL_SPIEL_ORIGIN=https://spiel-f29c55da.bunsenbrenner.org
DUELL_SPIEL_MODULE_DIR=/data/spiele
DUELL_APP_URL=https://demos-34a13a96.bunsenbrenner.org/duell
SMTP_PASS_FILE=/run/secrets/smtp.pass
# Pflicht (wie bisher gesetzt): ohne ihn bleibt der Bau aus (lib/duell-fk2-bau.mjs, fail closed). Wert unveraendert lassen.
# DUELL_IP_HEADER=<wie bisher>

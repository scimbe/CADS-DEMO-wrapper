# Demo wrapper environment. Copy to .env and fill in on the host.
# The wrapper listens on 127.0.0.1:8790 (ct-agent CT_AGENT_ORIGIN target).
# LLM-backed demos (newsletter, contractcheck, diagram, callcenter) call the SHARED litellm proxy:
export LITELLM_BASE_URL=https://llm-<...>.bunsenbrenner.org   # shared proxy (host already has access)
export LITELLM_API_KEY=<shared-proxy-key — provided out-of-band, NOT committed>
export LITELLM_DEFAULT_MODEL=local-devstral-small2
# install/activate trust allowlist = my publisher/holder pubkey:
export CT_MANIFEST_TRUST_ALLOWLIST=1292c0cc8da75808549be709101acec612a52d5219b188c0adcff6d829ace69b

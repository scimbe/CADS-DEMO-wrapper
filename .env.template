# Demo wrapper environment. Copy to .env and fill in on the host.
# The wrapper listens on 127.0.0.1:8790 (ct-agent CT_AGENT_ORIGIN target).
# LLM-backed demos (newsletter, contractcheck, diagram, callcenter) call the SHARED litellm proxy:
export LITELLM_BASE_URL=https://llm-<...>.bunsenbrenner.org   # shared proxy (host already has access)
export LITELLM_API_KEY=<shared-proxy-key — provided out-of-band, NOT committed>
export LITELLM_DEFAULT_MODEL=local-qwen36-35b-a3b-coding
# install/activate trust allowlist = my publisher/holder pubkey:
export CT_MANIFEST_TRUST_ALLOWLIST=1292c0cc8da75808549be709101acec612a52d5219b188c0adcff6d829ace69b

# --- Host deploy behind demos.bunsenbrenner.org (docker-compose.yml) ---
# DEMOS_JOIN_TOKEN=<fresh single-use token: POST https://bunsenbrenner.org/enroll/issue {tenant,hostname}>
# CT_TUNNEL_SRC=../CADS-Tunnel        # path to the CADS-Tunnel source for the ct-agent image
# DEMOS_AGENT_EDGE=                    # edge host:port if your plane requires it
# DEMOS_AGENT_EDGE_CERT_URL=

# Saved installations (lib/installations.mjs). Empty = off. The control plane holds its SHA-256.
export INSTALLATIONS_DELEGATE_TOKEN=
# 1 = auf der Startseite als aktiv zeigen, erst nach dem Test mit echtem Konto.
export INSTALLATIONS_LIVE=
# Published cads-run release; empty = instructions hidden, trust badge stays "in preparation".
export CADS_RUN_VERSION=
# Android app (APK) for the "run on your device" block. Both set = download link with checksum; either empty = "not available yet".
# URL must be https; SHA256 is the 64-hex digest of that exact file.
export CADS_ANDROID_APK_URL=
export CADS_ANDROID_APK_SHA256=

# My Daily Idea, KI-Aktionen (lib/duell-ai.mjs). Ohne DUELL_AI_SALT wird nichts gespeichert: das Kontingent beginnt mit jedem Neustart neu.
# Erzeugen mit: openssl rand -hex 32. Niemals committen.
export DUELL_AI_SALT=
export DUELL_AI_ENABLED=1
export DUELL_AI_FREE=3
# Konten mit Abo-Flag, kommagetrennt, nur zum Testen. Es gibt keinen Zahlungsweg.
export DUELL_AI_ABO_ALLOWLIST=
export DUELL_AI_ABO_PER_DAY=30
# Kopfzeile mit der echten Client-IP. Leer = keine Grenzen je IP fuer KI, Wetter und Kurzlinks.
export DUELL_IP_HEADER=
export DUELL_IP_SALT=

# Kurzlinks (lib/shortlink.mjs). SHORT_DATA_DIR setzt docker-compose.yml auf das Volume demos-shortlinks.
# Bei `docker run` selbst setzen: -e SHORT_DATA_DIR=/data/shortlinks -v demos-shortlinks:/data/shortlinks. Ohne sie bleibt die App beim langen Link.
export SHORT_TTL_DAYS=90
export SHORT_IP_PER_HOUR=20
export SHORT_DAILY_MAX=2000
export SHORT_MISS_PER_HOUR=60
export SHORT_MAX_LIVE=100000

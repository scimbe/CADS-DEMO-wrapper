  "control:X - flap=Tippen gibt Auftrieb, jump=Sprung vom Boden, lr/ud/move=links-rechts/hoch-runter/frei, drag=Finger zieht Schlaeger seitlich, steer=Richtung im Raster (Schlange), tap=Dinge antippen",
  "control:any:A,B - eine der genannten Steuerungen genuegt",
  "gravity - Welt hat Schwerkraft",
  "spawn - Dinge werden laufend neu erzeugt",
  "danger - Beruehren oder Herausfallen kostet ein Leben oder verliert",
  "bounce - etwas prallt ab (Ball)",
  "rule:W - touch=Ding beruehrt anderes, out=Ding verlaesst die Welt ueber einen Rand, tap=Ding wird angetippt, miss=Tippen trifft nichts (Fehltipp), every=alle n ms, clear=kein Ding einer Art mehr uebrig, pass=Figur kommt an etwas vorbei",
  "rule:any:A,B - eine der genannten Regeln genuegt",
  "players:N - N Spieler am selben Geraet (players:2 nur bei ausdruecklich zu zweit/gegeneinander)",
  "end:score - Ende bei Punktzahl",
  "end:time - Ende nach Zeitlimit",
  "grid - Raster",
  "trail - Schwanz waechst",
  "life - ein Ding verschwindet nach einer Zeit von selbst (Lebensdauer), nicht Leben des Spielers",
  "ai:X - chase=verfolgt die Figur, patrol=laeuft hin und her, flee=flieht, zigzag=Zickzack",
  "emoji:E / emoji_any:A,B - Emoji kommt im Spiel vor (nur bei eindeutigem Emoji im Satz)",
  "turn:K - place=Steine setzen, flip=Paare aufdecken, answer=Fragen",
  "line:N - N in einer Reihe",
  "drop - Steine fallen in Spalten",
  "ask:A - pick=Auswahl, type=eintippen",
  "form:F - plain, scramble=Buchstaben gemischt, gap=Luecken"
 ],
